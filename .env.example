# Optional. If unset, Tally generates one and stores it in DATA_DIR/.secret_key
# (0600), so sessions survive restarts. Generate manually with:
#   openssl rand -hex 32
# SECRET_KEY=

# Optional — defaults shown below
# FLASK_ENV=production
# DATA_DIR=/data
# USERS_DB_PATH=/data/users.db
# USER_DATA_DIR=/data/user_data
# UPLOADS_DIR=/data/uploads

# Server binding. Loopback by default: this database is your financial life.
# TALLY_HOST=127.0.0.1
# PORT=5000

# Set to 1 only when you intend to expose the app (put TLS and a token in front).
# TALLY_ALLOW_REMOTE=0
# TALLY_HTTPS=0

# Comma-separated origins allowed to make credentialed requests.
# Empty means same-origin only, which is what the bundled UI needs.
# TALLY_CORS_ORIGINS=https://tally.example.com

# Encryption key for bank credentials (urlsafe base64, 32 bytes).
# If unset, generated at DATA_DIR/.encryption_key (0600). Back it up: without it,
# bank connections cannot be decrypted.
# TALLY_ENCRYPTION_KEY=

# Upload cap for statements.
# TALLY_MAX_UPLOAD_MB=50

# --- Network MCP (optional) -------------------------------------------------
# Serve MCP over streamable HTTP beside the web UI. Docker images enable this.
# TALLY_MCP_HTTP=1
# TALLY_MCP_PORT=8765
# Comma-separated Host allowlist; unset means "trust the bearer token instead".
# TALLY_MCP_ALLOWED_HOSTS=finance.lan,192.168.1.50

# --- OCR (optional override) ------------------------------------------------
# rapidocr (default when installed) | tesseract | none
# TALLY_OCR_ENGINE=rapidocr

# --- Bank connections (optional) -------------------------------------------
# Enable Banking (EU/UK). Create an app in their Control Panel and upload the
# public half of an RSA key pair. The Application ID is the JWT `kid`.
# ENABLEBANKING_APP_ID=
# ENABLEBANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# SimpleFIN Bridge (US/CA) needs no configuration: link with a setup token.
