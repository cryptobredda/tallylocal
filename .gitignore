# ============================================
# Tally Local - .gitignore
# ============================================
# This file tells Git which files/folders to ignore.
# Files listed here will NOT be pushed to GitHub.
# ============================================

# --------------------------------------------
# Python Virtual Environment
# --------------------------------------------
# IGNORE: Contains installed packages specific to your machine
venv/
.venv/
env/
.env/

# --------------------------------------------
# Python Cache Files
# --------------------------------------------
# IGNORE: Auto-generated bytecode files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --------------------------------------------
# Database Files
# --------------------------------------------
# IGNORE: User's personal financial data (auto-regenerates on app start)
*.db
*.sqlite
*.sqlite3

# --------------------------------------------
# Uploaded Files
# --------------------------------------------
# IGNORE: User's bank statements and receipts (sensitive data!)
uploads/

# --------------------------------------------
# Backup Files
# --------------------------------------------
# IGNORE: Personal data exports and backups
*.json
!package.json
!package-lock.json

# --------------------------------------------
# IDE / Editor Settings
# --------------------------------------------
# IGNORE: Personal editor configurations
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --------------------------------------------
# OS Generated Files
# --------------------------------------------
# IGNORE: System files that vary by OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --------------------------------------------
# Environment Variables
# --------------------------------------------
# IGNORE: May contain API keys or secrets
.env
.env.local
.env.*.local
*.env

# --------------------------------------------
# Logs
# --------------------------------------------
# IGNORE: Runtime logs
*.log
logs/

# --------------------------------------------
# Test / Coverage
# --------------------------------------------
# IGNORE: Test artifacts
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# --------------------------------------------
# Factory AI
# --------------------------------------------
# IGNORE: Factory session data
.factory/

# ============================================
# FILES TO INCLUDE (NOT ignored)
# ============================================
# The following are tracked by Git:
#
# - app/                  (all Python source code)
# - static/               (HTML, CSS, JS frontend)
# - screenshots/          (README screenshots)
# - requirements.txt      (Python dependencies)
# - run.py               (Application entry point)
# - README.md            (Project documentation)
# - LICENSE              (MIT license)
# - .gitignore           (this file)
# ============================================
# --------------------------------------------
# Runtime secrets (generated on first run)
# --------------------------------------------
.secret_key
.encryption_key
*.pem
instance/
data/
